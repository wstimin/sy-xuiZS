PORT=1888

# Optional API protection. When set, a trusted reverse proxy must add either:
# Authorization: Bearer <token>
# X-App-Token: <token>
APP_AUTH_TOKEN=

# Commercial data and browser session settings.
# Production installs should keep this outside the release directory.
DATABASE_PATH=/var/lib/xui-assistant/app.db
SESSION_COOKIE_SECURE=

# Optional stable encryption secret for SMTP and payment credentials.
# Set it before saving commercial secrets, keep it private, and never rotate it casually.
# When left blank, APP_AUTH_TOKEN is used if set; otherwise DATABASE_PATH.key is created automatically.
COMMERCIAL_SECRET_KEY=

# Optional HTTPS certificate paths for this assistant itself.
SSL_CERT=
SSL_KEY=
