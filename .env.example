PORT=1888

# Optional API protection. When set, a trusted reverse proxy must add either:
# Authorization: Bearer <token>
# X-App-Token: <token>
APP_AUTH_TOKEN=

# Commercial data and browser session settings.
# Production installs should keep this outside the release directory.
DATABASE_PATH=/var/lib/xui-assistant/app.db
SESSION_COOKIE_SECURE=

# Optional HTTPS certificate paths for this assistant itself.
SSL_CERT=
SSL_KEY=
